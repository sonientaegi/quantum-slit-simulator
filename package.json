{
  "name": "quantum-slit-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:single": "tsc -b && vite build --mode singlefile",
    "electron:dev": "pnpm build && electron .",
    "electron:build": "pnpm build && electron-builder --mac"
  },
  "build": {
    "appId": "com.quantum.slit-simulator",
    "productName": "Quantum Slit Simulator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  }
}